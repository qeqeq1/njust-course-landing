#!/bin/bash
# Replace placeholder or previous hash with current HEAD hash before each commit

HASH=$(git rev-parse --short HEAD 2>/dev/null || echo "0000000")
# Matches either {{COMMIT_HASH}} or build: <hex>
sed -i -E "s/(build: )(\{\{COMMIT_HASH\}\}|[a-f0-9]+)/\1${HASH}/g" index.html
git add index.html
